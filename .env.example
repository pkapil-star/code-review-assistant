# Copy to .env and fill in your own values. Never commit .env.
ENVIRONMENT=development

# GitHub App (github.com/settings/apps)
GITHUB_APP_ID=your-app-id
GITHUB_WEBHOOK_SECRET=your-webhook-secret
GITHUB_PRIVATE_KEY_PATH=secrets/private-key.pem

# AI review layer. Provider: anthropic | mock
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Review behaviour
MAX_COMMENTS_PER_REVIEW=20
MAX_DIFF_BYTES=100000
POST_COMMENTS=true

# Queue: memory | redis
QUEUE_BACKEND=memory
REDIS_URL=redis://localhost:6379/0
QUEUE_MAX_RETRIES=3
